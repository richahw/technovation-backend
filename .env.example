# Copy this to .env and fill in your values

# ── Supabase Postgres ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.iazejervmaeyuduyjowb.supabase.co:5432/postgres

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# LOCAL: keep as localhost
# PRODUCTION: set to your live URL e.g. https://your-app.onrender.com/auth/google/callback
# On Render/Railway you can leave this blank — it auto-detects from RENDER_EXTERNAL_HOSTNAME
# But you MUST also add the live URL in Google Cloud Console → Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Cal.com (future weeks) ────────────────────────────────────────────
CALCOM_API_KEY=your-calcom-api-key
